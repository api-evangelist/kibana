{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kibana APIs Actions system API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "system",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get features",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{kibana_url}/api/features"
          },
          "docs": "Get information about all Kibana features. Features are used by spaces and security to refine and secure access to Kibana.\n"
        },
        {
          "info": {
            "name": "Get Kibana's current status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{kibana_url}/api/status",
            "params": [
              {
                "name": "v7format",
                "value": "",
                "type": "query",
                "description": "Set to \"true\" to get the response in v7 format."
              },
              {
                "name": "v8format",
                "value": "",
                "type": "query",
                "description": "Set to \"true\" to get the response in v8 format."
              }
            ]
          },
          "docs": "Get Kibana's current status"
        }
      ]
    }
  ],
  "bundled": true
}