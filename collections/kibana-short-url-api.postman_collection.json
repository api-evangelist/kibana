        {
          "id": "905e6961-41e7-471f-af87-d36bc23156c7",
          "name": "Create a short URL",
          "request": {
            "name": "Create a short URL",
            "description": {
              "content": "Kibana URLs may be long and cumbersome, short URLs are much easier to remember and share.\nShort URLs are created by specifying the locator ID and locator parameters. When a short URL is resolved, the locator ID and locator parameters are used to redirect user to the right Kibana page.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "short_url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{kibana_url}}",
                  "key": "kibana_url"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locatorId\": \"<string>\",\n  \"params\": \"<object>\",\n  \"humanReadableSlug\": \"<boolean>\",\n  \"slug\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "0285a005-0c6f-4b9b-a3d3-703d35b9f485",
              "name": "Indicates a successful call.",
