      "id": "9f4a684d-807d-4ea2-9904-0415e5218cc0",
      "name": "Fleet remote synced integrations",
      "description": {
        "content": "Use the Fleet remote synced integrations API to check the status of the automatic integrations synchronization on a remote cluster:\n* Use the `/api/fleet/remote_synced_integrations/{outputId}/remote_status` endpoint on the management cluster to query the synchronization status of the integrations installed on the remote cluster by the ID of the configured remote Elasticsearch output.\n* Use the `/api/fleet/remote_synced_integrations/status` endpoint on the remote cluster to query the synchronization status of the installed integrations.\n",
        "type": "text/plain"
      },
