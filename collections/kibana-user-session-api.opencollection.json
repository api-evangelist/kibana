{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kibana APIs Actions user session API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "user session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Invalidate user sessions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{kibana_url}/api/security/session/_invalidate",
            "headers": [
              {
                "name": "kbn-xsrf",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invalidate user sessions that match a query. To use this API, you must be a superuser.\n"
        }
      ]
    }
  ],
  "bundled": true
}