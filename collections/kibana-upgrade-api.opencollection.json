{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kibana APIs Actions upgrade API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "upgrade",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the upgrade readiness status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{kibana_url}/api/upgrade_assistant/status"
          },
          "docs": "Check the status of your cluster."
        }
      ]
    }
  ],
  "bundled": true
}