  "item": [
    {
      "id": "6c49cec7-92b2-4a31-a82d-0cfcc5def91b",
      "name": "Message Signing Service",
      "description": {
        "content": "Enables you to rotate message signing key pairs for secure Fleet communication.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5e95d7d2-dc9c-4ee6-8949-577f504293fd",
          "name": "Rotate a Fleet message signing key pair",
          "request": {
            "name": "Rotate a Fleet message signing key pair",
            "description": {
              "content": "**Spaces method and path for this operation:**\n\n<div><span class=\"operation-verb post\">post</span>&nbsp;<span class=\"operation-path\">/s/{space_id}/api/fleet/message_signing_service/rotate_key_pair</span></div>\n\nRefer to [Spaces](https://www.elastic.co/docs/deploy-manage/manage-spaces) for more information.\n\nRotate the key pair used by Fleet to sign messages sent to Elastic Agents. This operation is irreversible and requires all agents in the Fleet to be re-enrolled after rotation. You must explicitly acknowledge the risk by passing `acknowledge=true` as a query parameter.<br/><br/>[Required authorization] Route required privileges: fleet-agents-all AND fleet-agent-policies-all AND fleet-settings-all.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "fleet",
                "message_signing_service",
                "rotate_key_pair"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "acknowledge",
                  "value": "false",
                  "description": "Set to true to confirm you understand the risks of rotating the key pair"
                }
              ],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{kibana_url}}",
                  "key": "kibana_url"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) A required header to protect against CSRF attacks",
                "key": "kbn-xsrf",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "412feaf0-a788-4d20-971c-ff2f7338464f",
              "name": "Key pair rotated successfully",
              "originalRequest": {
