        {
          "id": "4d3f92d5-321d-4d81-954d-8ed52550ef6b",
          "name": "Update uptime settings",
          "request": {
            "name": "Update uptime settings",
            "description": {
              "content": "**Spaces method and path for this operation:**\n\n<div><span class=\"operation-verb put\">put</span>&nbsp;<span class=\"operation-path\">/s/{space_id}/api/uptime/settings</span></div>\n\nRefer to [Spaces](https://www.elastic.co/docs/deploy-manage/manage-spaces) for more information.\n\nUpdate uptime setting attributes like `heartbeatIndices`, `certExpirationThreshold`, `certAgeThreshold`, `defaultConnectors`, or `defaultEmail`. You must have `all` privileges for the uptime feature in the Observability section of the Kibana feature privileges. A partial update is supported, provided settings keys will be merged with existing settings.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "uptime",
                "settings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{kibana_url}}",
                  "key": "kibana_url"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"certAgeThreshold\": 730,\n  \"certExpirationThreshold\": 30,\n  \"defaultEmail\": {},\n  \"heartbeatIndices\": \"heartbeat-*\"\n}",
